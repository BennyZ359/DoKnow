# --- Database ---
POSTGRES_USER=doknow
POSTGRES_PASSWORD=doknow
POSTGRES_DB=doknow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://doknow:doknow@localhost:5432/doknow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Security / Auth ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider (OpenAI-compatible; supports any gateway) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
# Embeddings model used for vector search / memory recall
EMBEDDING_MODEL=text-embedding-3-small

# --- Document parsing ---
# docling (primary) or mineru (optional)
PARSER_BACKEND=docling

# --- Observability ---
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
