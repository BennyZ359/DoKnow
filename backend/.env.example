# Copy to .env. Demo works without an API key and clearly labels its limitations.
DATABASE_URL=sqlite:///./data/doknow.db
AI_PROVIDER=demo
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional cache; learning records always remain in the database.
REDIS_URL=
