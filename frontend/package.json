{
  "name": "doknow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json .prettierrc.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json .prettierrc.json index.html"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.4.5",
    "vue-tsc": "^3.3.14"
  }
}
